<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.earshot"
    android:versionCode="1"
    android:versionName="0.1.0">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35" />

    <!-- Only used to reach 127.0.0.1, which adb tunnels to the Mac. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keep CPU and Wi-Fi awake while playing with the screen locked. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <application
        android:label="Earshot"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="false">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".EarshotTileService"
            android:exported="true"
            android:label="Play on Mac"
            android:icon="@drawable/ic_ear"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>

        <!-- The Mac reports state through adb. DUMP is held by the adb shell and not by apps. -->
        <receiver
            android:name=".StateReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.earshot.STATE" />
                <action android:name="dev.earshot.SUGGEST" />
            </intent-filter>
        </receiver>

        <receiver android:name=".ActionReceiver" android:exported="false" />

        <!-- Started and stopped by the Mac through adb while audio is playing. -->
        <service
            android:name=".ShakeService"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:foregroundServiceType="connectedDevice" />
        <service
            android:name=".KeepAwakeService"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
